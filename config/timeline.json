  "dialogue": [
    {
      "id": "line_01",
      "beatId": "beat_1_mud_hook",
      "speaker": "narrator",
      "start": 0.22,
      "end": 2.18,
      "text": "1632! Build a marble wonder on MUD?!"
    },
    {
      "id": "line_02",
      "beatId": "beat_1_mud_hook",
      "speaker": "inspector",
      "start": 2.24,
      "end": 3.42,
      "text": "Wait—won't it sink?!"
    },
    {
      "id": "line_03",
      "beatId": "beat_2_river_wells",
      "speaker": "inspector",
      "start": 3.65,
      "end": 5.45,
      "text": "Even my elephant sinks in this mud!"
    },
    {
      "id": "line_04",
      "beatId": "beat_2_river_wells",
      "speaker": "architect",
      "start": 5.55,
      "end": 8.05,
      "text": "We sink brick wells—river water turns timber stone-hard!"
    },
    {
      "id": "line_05",
      "beatId": "beat_3_marble_dome",
      "speaker": "narrator",
      "start": 8.42,
      "end": 11.20,
      "text": "Fifteen-mile spiral ramps haul gleaming white marble skyward!"
    },
    {
      "id": "line_06",
      "beatId": "beat_3_marble_dome",
      "speaker": "architect",
      "start": 11.38,
      "end": 14.78,
      "text": "Now crown the lotus dome with solid golden spires!"
    },
    {
      "id": "line_07",
      "beatId": "beat_4_leaning_minarets",
      "speaker": "inspector",
      "start": 15.22,
      "end": 17.45,
      "text": "Boss! Those four towers lean OUTWARD!"
    },
    {
      "id": "line_08",
      "beatId": "beat_4_leaning_minarets",
      "speaker": "architect",
      "start": 17.60,
      "end": 20.65,
      "text": "Built that way! In quakes, they fall AWAY from the dome!"
    },
    {
      "id": "line_09",
      "beatId": "beat_5_moonlight_glow",
      "speaker": "narrator",
      "start": 21.02,
      "end": 23.22,
      "text": "Sunset paints it gold—then moonlight makes it glow!"
    },
    {
      "id": "line_10",
      "beatId": "beat_5_moonlight_glow",
      "speaker": "inspector",
      "start": 23.35,
      "end": 25.60,
      "text": "Pure Mughal genius... take all my gold!"
    },
    {
      "id": "line_11",
      "beatId": "beat_6_charbagh_finale",
      "speaker": "narrator",
      "start": 25.92,
      "end": 29.70,
      "text": "Four centuries strong on river wood! Subscribe for the next wonder!"
    }
  ],
